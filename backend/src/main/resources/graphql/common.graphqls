# GraphQL Schema — Common Types

scalar DateTime
scalar JSON

enum ChannelType {
    TWITTER
    INSTAGRAM
    FACEBOOK
    LINKEDIN
    YOUTUBE
    TIKTOK
    EMAIL
    SMS
    WHATSAPP
}

enum CampaignStatus {
    DRAFT
    SCHEDULED
    ACTIVE
    PAUSED
    COMPLETED
    CANCELLED
}

enum MessageStatus {
    UNREAD
    READ
    REPLIED
    ARCHIVED
}

enum SentimentType {
    POSITIVE
    NEUTRAL
    NEGATIVE
}

enum UserRole {
    ADMIN
    MANAGER
    ANALYST
    AGENT
    VIEWER
}

type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}
