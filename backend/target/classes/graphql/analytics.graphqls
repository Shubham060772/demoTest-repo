type EngagementMetric {
    id: ID!
    channel: Channel!
    date: DateTime!
    impressions: Int!
    clicks: Int!
    likes: Int!
    shares: Int!
    comments: Int!
    engagementRate: Float!
    reach: Int!
}

type AnalyticsSummary {
    totalImpressions: Int!
    totalClicks: Int!
    totalEngagements: Int!
    averageEngagementRate: Float!
    sentimentBreakdown: SentimentBreakdown!
    channelPerformance: [ChannelPerformance!]!
    dailyMetrics: [DailyMetric!]!
}

type SentimentBreakdown {
    positive: Int!
    neutral: Int!
    negative: Int!
    positivePercent: Float!
    negativePercent: Float!
    neutralPercent: Float!
}

type ChannelPerformance {
    channel: Channel!
    impressions: Int!
    clicks: Int!
    engagementRate: Float!
    messageCount: Int!
}

type DailyMetric {
    date: DateTime!
    impressions: Int!
    clicks: Int!
    engagements: Int!
}

type Dashboard {
    totalCustomers: Int!
    activeCampaigns: Int!
    totalMessages: Int!
    unreadMessages: Int!
    totalChannels: Int!
    overallEngagementRate: Float!
    recentMessages: [Message!]!
    topCampaigns: [Campaign!]!
    channelBreakdown: [ChannelPerformance!]!
}
